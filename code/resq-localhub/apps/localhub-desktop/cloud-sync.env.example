# Copy to %USERPROFILE%\.resq-localhub\cloud-sync.env (outside the installation).
# Environment variables take precedence. Never bundle or commit a populated file.
# Public endpoint retained from the desktop's existing release configuration.
RESQ_CLOUD_SYNC_ENABLED=true
RESQ_CLOUD_SYNC_BASE_URL=https://0p72nthzej.execute-api.ap-southeast-1.amazonaws.com
RESQ_CLOUD_SYNC_FIXED_DELAY_MS=60000
RESQ_CLOUD_SYNC_REQUEST_TIMEOUT_MS=5000
RESQ_CLOUD_SYNC_BATCH_SIZE=5
# Permanent errors stop after this count; offline/429/5xx failures keep retrying.
RESQ_CLOUD_SYNC_MAX_RETRY_COUNT=3
# Optional separate upload identity; if absent, the roster identity below is used.
# RESQ_CLOUD_SYNC_HUB_ID=
# RESQ_CLOUD_SYNC_HUB_KEY=
RESQ_ROSTER_SYNC_ENABLED=true
RESQ_ROSTER_SYNC_BASE_URL=https://0p72nthzej.execute-api.ap-southeast-1.amazonaws.com
# Supply the registered hub identity and key privately. Empty means unconfigured.
RESQ_ROSTER_SYNC_HUB_ID=
RESQ_ROSTER_SYNC_HUB_KEY=
RESQ_ROSTER_SYNC_FIXED_DELAY_MS=60000
RESQ_ROSTER_SYNC_TIMEOUT_MS=10000
