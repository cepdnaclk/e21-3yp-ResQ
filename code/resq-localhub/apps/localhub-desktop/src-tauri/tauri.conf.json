{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ResQ Local Hub",
  "version": "1.2.0",
  "identifier": "resq.ce.pdn.ac.lk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:release",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ResQ Local Hub",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:18080 http://localhost:18080 ws://127.0.0.1:9001 ws://localhost:9001; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/hub-api/resq-hub-api.jar": "hub-api/resq-hub-api.jar",
      "resources/config/application-release.properties": "config/application-release.properties",
      "resources/jre": "jre",
      "resources/mosquitto": "mosquitto",
      "resources/web-dashboard": "web-dashboard"
    }
  }
}
