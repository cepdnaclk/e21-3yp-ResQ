CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

# Keep the native USB controller available for the reboot-only USB mode, but
# never mirror application logs to it. SENSOR mode owns GPIO19 and logs over
# UART0; USB ownership is restored only by rebooting into USB mode.
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Session state publication validates committed calibration metadata through
# NVS. Keep enough main-task stack for that synchronous IDF call chain.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
